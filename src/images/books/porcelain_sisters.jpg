                    P.when('jQuery','SocialShareWidgetAUI').execute(function ($) {
                        var shareIcon = $('#ssf-primary-widget-desktop');
                        var shareIconBg = shareIcon.find('.ssf-background-float');
                        var TITLE_SELECTOR = '#titleblock_feature_div,#digitaltextfeedsTitle,#titleSection';

                        // Attach the share icon to the title container if it exists.
                        // Returns true on success, false if the title container isn't in the DOM yet.
                        function attachShareIconToTitleContainer() {
                            var titleContainer = $(TITLE_SELECTOR);
                            if (titleContainer.length) {
                                titleContainer.prepend(shareIcon);
                                shareIconBg.removeClass('aok-hidden');
                                return true;
                            }
                            return false;
                        }

                        // Fast path: title container already streamed, attach immediately.
                        if (attachShareIconToTitleContainer()) { return; }

                        // Title container hasn't streamed yet. P.when fires as soon as
                        // jQuery and SocialShareWidgetAUI are registered, which happens
                        // well before all DPX features finish streaming -- so the title
                        // block may not be in the DOM at this moment. Watch for it
                        // (MutationObserver on modern browsers, polling fallback on older
                        // browsers), with a 1s ceiling to bound the wait.
                        //
                        // If we never find the title container in that window, fail open
                        // by revealing the widget in place. Users keep their share
                        // functionality even when the preferred placement is unavailable.
                        // This mirrors the defensive pattern in shareCommon.jsp.

                        // Set a 1 second timeout to stop waiting for title container div element.
                        var timeoutId = setTimeout(function () {
                            if (observer && observer.disconnect) {
                                observer.disconnect();
                            }
                            if (interval) { clearInterval(interval); }
                            // Fail open: make the widget visible in its natural position
                            // so it is never permanently hidden.
                            shareIconBg.removeClass('aok-hidden');
                            if (window.ue && window.ue.count) {
                                window.ue.count('ssf-byline-failopen-timeout', 1);
                            }
                        }, 1000);

                        // Only one of observer/interval is active: observer for modern browsers, interval for legacy.
                        var observer;
                        if (window.MutationObserver) {
                            observer = new MutationObserver(function () {
                                if (attachShareIconToTitleContainer()) {
                                    observer.disconnect();
                                    clearTimeout(timeoutId);
                                }
                            });
                            observer.observe(document.body, {
                                childList: true,
                                subtree: true
                            });
                        }

                        var interval;
                        if (!window.MutationObserver) {
                            interval = setInterval(function () {
                                if (attachShareIconToTitleContainer()) {
                                    clearInterval(interval);
                                    clearTimeout(timeoutId);
                                }
                            }, 100);
                        }
                    });
                }));</script>                                     </div>
